<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sustainability — securelayer.co</title>
    <meta
      name="description"
      content="How securelayer.co keeps its environmental footprint low — green hosting, a static no-database architecture, and independently verified carbon impact."
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #0a0f0f;
        color: #e0e0e0;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 14px;
        line-height: 1.6;
        min-height: 100vh;
      }

      .page {
        max-width: 1240px;
        margin: 0 auto;
        padding: 40px 24px 80px;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      .section-title {
        font-size: 13px;
        font-weight: 700;
        color: #888;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        margin-bottom: 16px;
      }

      .pipeline-card {
        background: #0d1a1a;
        border: 1px solid #1a3030;
        border-radius: 8px;
        padding: 24px;
        margin-bottom: 48px;
      }
      .pipeline-checks {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
      }
      .check-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
      }
      .check-icon {
        color: #4ade80;
        font-size: 14px;
        font-weight: 800;
        flex-shrink: 0;
        margin-top: 2px;
      }
      .check-label strong {
        color: #e0e0e0;
        font-size: 12px;
        font-weight: 700;
        display: block;
        margin-bottom: 3px;
      }
      .check-label .check-desc {
        font-size: 12px;
        color: #808080;
        line-height: 1.5;
      }

      /* ── Browser chrome (Firefox) ── */
      .browser-window {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .browser-titlebar {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #1c1b22;
        padding: 10px 16px 0;
        border-bottom: 1px solid #2f2e38;
      }
      .traffic-lights {
        display: flex;
        gap: 8px;
        padding-bottom: 10px;
        flex-shrink: 0;
      }
      .tl {
        width: 12px;
        height: 12px;
        border-radius: 50%;
      }
      .tl.red {
        background: #ff5f57;
      }
      .tl.yellow {
        background: #febc2e;
      }
      .tl.green {
        background: #28c840;
      }

      .browser-tab {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #2b2a33;
        border-radius: 8px 8px 0 0;
        padding: 8px 12px;
        max-width: 260px;
      }
      .tab-favicon {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
      }
      .tab-title {
        font-size: 12.5px;
        color: #e8e6ee;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .tab-close {
        margin-left: auto;
        color: #8a8794;
        font-size: 15px;
        line-height: 1;
        flex-shrink: 0;
      }
      .tab-add {
        color: #8a8794;
        font-size: 18px;
        padding: 0 10px 10px;
        line-height: 1;
        align-self: center;
      }
      .tab-chevron {
        color: #8a8794;
        font-size: 12px;
        padding-bottom: 10px;
        align-self: center;
      }

      .private-badge {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 6px;
        color: #c689ff;
        font-size: 12px;
        padding-bottom: 10px;
        white-space: nowrap;
      }
      .private-badge svg {
        width: 15px;
        height: 15px;
      }

      .browser-navbar {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #2b2a33;
        padding: 10px 16px;
        border-bottom: 1px solid #2f2e38;
      }
      .nav-icon {
        color: #9d9aa8;
        flex-shrink: 0;
        display: flex;
        align-items: center;
      }
      .nav-icon svg {
        width: 17px;
        height: 17px;
      }
      .nav-icon.disabled {
        color: #514f5c;
      }
      .address-pill {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #42414d;
        border-radius: 7px;
        padding: 7px 14px;
        max-width: 640px;
        margin: 0 auto;
      }
      .address-pill svg {
        width: 14px;
        height: 14px;
        color: #9d9aa8;
        flex-shrink: 0;
      }
      .addr-text {
        font-size: 13px;
        color: #e8e6ee;
        flex: 1;
      }
      .addr-path {
        color: #b0adb9;
      }
      .addr-star {
        margin-left: auto;
      }
      .vpn-badge {
        display: flex;
        align-items: center;
        gap: 5px;
        background: rgba(255, 95, 87, 0.12);
        border: 1px solid rgba(255, 95, 87, 0.35);
        color: #ff8a80;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
        padding: 4px 9px;
        border-radius: 5px;
        flex-shrink: 0;
      }
      .vpn-badge svg {
        width: 11px;
        height: 11px;
      }
      .nav-fox {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
      }
      .nav-menu svg {
        width: 18px;
        height: 18px;
      }

      .browser-body {
        flex: 1;
      }

      .page-hero {
        max-width: 640px;
        margin: 0 auto;
        padding: 8px 24px 40px;
        text-align: center;
      }
      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(74, 222, 128, 0.1);
        border: 1px solid rgba(74, 222, 128, 0.2);
        color: #4ade80;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 5px 14px;
        border-radius: 100px;
        margin-bottom: 20px;
      }
      .badge-dot {
        width: 6px;
        height: 6px;
        background: #4ade80;
        border-radius: 50%;
      }
      .page-hero h1 {
        font-size: clamp(1.4rem, 3.4vw, 2rem);
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
      }
      .page-hero p {
        color: #999;
        font-size: 0.875rem;
        margin-bottom: 16px;
        line-height: 1.6;
      }

      /* ── score-card pattern (matches security.astro) ── */
      .scores-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-bottom: 48px;
      }
      .score-card {
        background: #0d1a1a;
        border: 1px solid #1a3030;
        border-radius: 8px;
        padding: 24px;
        color: inherit;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .service-name {
        font-size: 13px;
        font-weight: 700;
        color: #aaa;
        letter-spacing: 0.3px;
      }
      .grade-badge {
        font-size: 22px;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 6px;
        line-height: 1.4;
        flex-shrink: 0;
      }
      .grade-Aplus {
        color: #4ade80;
        background: #0d2a0d;
        border: 1px solid #166534;
      }
      .grade-safe {
        color: #5eead4;
        background: #0d2a2a;
        border: 1px solid #0d9488;
        font-size: 13px;
      }
      .card-desc {
        font-size: 12px;
        color: #808080;
        line-height: 1.5;
      }
      .card-link {
        font-size: 12px;
        color: #0d9488;
        letter-spacing: 0.3px;
      }

      /* mobile-only plain-comparison descriptions — shown instead of the desktop .card-desc */
      .m-card-desc {
        display: none;
      }

      /* ── Footer ── */
      .site-footer {
        border-top: 1px solid #1a3030;
        padding: 40px 24px;
        text-align: center;
        margin-top: 24px;
      }
      .site-footer p {
        color: #888;
        font-size: 13px;
      }
      .footer-links {
        margin-top: 14px;
        display: flex;
        justify-content: center;
        gap: 20px;
      }
      .footer-links a {
        font-size: 12px;
        color: #888;
        text-decoration: none;
      }
      .footer-links a:hover {
        color: #5eead4;
      }
      .footer-green-link {
        display: inline-block;
        margin-top: 18px;
        opacity: 0.85;
        transition: opacity 0.2s;
      }
      .footer-green-link:hover {
        opacity: 1;
      }
      .footer-green-link img {
        display: block;
        width: 100px;
        height: auto;
        margin: 0 auto;
      }
      .footer-copy {
        margin-top: 12px;
        font-size: 12px;
      }

      /* ══════════ MOBILE SCENE · Phase B push (2026-08-26) ══════════
       Below 860px, drops the Firefox browser-chrome and the dark theme entirely for the
       blurred-photo + iOS frosted-glass system shared with the homepage and /security. */
      .m-statusbar,
      .m-bg,
      .m-scrim,
      .m-hero {
        display: none;
      }

      @media (max-width: 860px) {
        .browser-titlebar,
        .browser-navbar {
          display: none;
        }
        .m-statusbar,
        .m-bg,
        .m-scrim,
        .m-hero {
          display: block;
        }

        body {
          background: #f0e9da;
        }
        .browser-window,
        .browser-body,
        .page {
          background: transparent;
        }
        .page {
          padding-top: 8px;
        }
        .page-hero {
          display: none;
        }

        .m-statusbar {
          position: sticky;
          top: 0;
          z-index: 30;
          display: flex;
          align-items: center;
          justify-content: space-between;
          height: 30px;
          padding: 0 16px;
          color: #fff;
          font-family: "Helvetica Neue", Arial, sans-serif;
          text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
        }
        .m-statusbar-brand {
          font-size: 0.72rem;
          font-weight: 800;
        }
        .m-statusbar-icons {
          display: flex;
          align-items: center;
          gap: 6px;
        }
        .m-statusbar-icons svg {
          display: block;
        }

        .m-bg {
          position: fixed;
          inset: -40px;
          z-index: -2;
          background: url("/images/wallpaper-beach.webp") center 55% / cover
            no-repeat;
          filter: blur(30px) saturate(1.15) brightness(0.92);
          transform: scale(1.08);
        }
        .m-scrim {
          position: fixed;
          inset: 0;
          z-index: -1;
          background: rgba(20, 18, 14, 0.22);
        }

        .m-hero {
          padding: 18px 24px 4px;
        }
        .m-hero h1 {
          font-size: 1.4rem;
          font-weight: 700;
          color: #17140f;
          margin-bottom: 8px;
        }
        .m-hero p {
          font-size: 0.78rem;
          color: rgba(23, 20, 15, 0.75);
          line-height: 1.5;
        }

        .m-card-desc {
          display: block;
          font-size: 0.85rem;
          color: rgba(23, 20, 15, 0.72);
          line-height: 1.55;
          margin-bottom: 6px;
        }

        .score-card {
          background: rgba(255, 255, 255, 0.42);
          backdrop-filter: blur(28px) saturate(150%);
          -webkit-backdrop-filter: blur(28px) saturate(150%);
          border: 1px solid rgba(255, 255, 255, 0.45);
          box-shadow: 0 8px 26px rgba(0, 0, 0, 0.12);
        }
        .service-name {
          color: #17140f;
          font-size: 0.95rem;
        }
        .card-desc {
          display: none;
        }
        .card-link {
          color: #a8791f;
          font-size: 0.85rem;
        }
        .grade-badge {
          font-size: 1.15rem;
        }
        .grade-Aplus {
          color: #1a7a3d;
          background: rgba(74, 222, 128, 0.22);
          border: 1px solid rgba(26, 122, 61, 0.3);
        }
        .grade-safe {
          color: #0d6d63;
          background: rgba(94, 234, 212, 0.25);
          border: 1px solid rgba(13, 109, 99, 0.3);
          font-size: 0.95rem;
          padding: 6px 14px;
        }

        .section-title {
          color: rgba(23, 20, 15, 0.55);
        }
        .pipeline-card {
          background: rgba(255, 255, 255, 0.42);
          backdrop-filter: blur(28px) saturate(150%);
          -webkit-backdrop-filter: blur(28px) saturate(150%);
          border: 1px solid rgba(255, 255, 255, 0.45);
          box-shadow: 0 8px 26px rgba(0, 0, 0, 0.12);
        }
        .check-label strong {
          color: #17140f;
        }
        .check-label .check-desc {
          color: rgba(23, 20, 15, 0.65);
        }

        .site-footer {
          border-top-color: rgba(23, 20, 15, 0.15);
        }
        .site-footer p {
          color: rgba(23, 20, 15, 0.6);
        }
        .footer-links a {
          color: rgba(23, 20, 15, 0.6);
        }
        .footer-links a:hover {
          color: #17140f;
        }
      }
    </style>
  </head>
