---
import Layout from "../layouts/Layout.astro";
import logoSource from "../../public/logo.svg?raw";

// Inlined (not <img>) so the glowing wallpaper mark can be recolored via
// CSS `currentColor` — the source file hardcodes fill="#000000" and also
// carries a tiny (~2% viewBox height) accessibility label that would read
// as visual noise at large size, so both are stripped here.
const logoMark = logoSource
  .replace('fill="#000000"', 'fill="currentColor"')
  .replace(/<text[^>]*>.*?<\/text>/s, "");
---

<Layout
  title="SecureLayer — Security is a habit, not a project"
  description="SecureLayer — freelance cybersecurity services. Application security, SecDevOps, IT security, and AI security. Book a call to make checking your security a habit, not a once-a-year project."
>
  <div class="os">
    <!-- DESKTOP LOCK SCREEN · shown first on desktop viewports, mirrors the mobile
         lock/stand screen's "click or submit to unlock" pattern, styled like a real
         macOS lock screen (date/time, avatar, password field). -->
    <div class="d-lock" id="dLock">
      <div class="d-lock-bg" aria-hidden="true"></div>
      <div class="d-lock-scrim" aria-hidden="true"></div>
      <div class="d-lock-content">
        <div class="d-lock-date" id="dLockDate">Friday, August 28</div>
        <div class="d-lock-time" id="dLockTime">03.52</div>

        <div class="d-lock-user">
          <div class="d-lock-avatar" set:html={logoMark} />
          <div class="d-lock-name">SecureLayer</div>
          <form class="d-lock-pass" id="dLockForm">
            <input
              type="password"
              class="d-lock-input"
              placeholder="Enter Password"
              autocomplete="off"
            />
            <button type="submit" class="d-lock-arrow" aria-label="Unlock">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none"
                ><path
                  d="M4 8h8M8 4l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- MENU BAR -->
    <div class="menu-bar">
      <div class="menu-left">
        <img src="/logo.svg" alt="" class="menu-logo" />
        <span class="menu-brand">SecureLayer</span>
        <a
          href="#"
          class="menu-item"
          data-preview-file="secdevops-pipeline.png"
          data-preview-accent="#3a3428"
          data-preview-img="/images/previews/secdevops-pipeline.png"
          >SecDevOps</a
        >
        <a
          href="#"
          class="menu-item"
          data-preview-file="security-page.png"
          data-preview-accent="var(--cyan)"
          data-preview-img="/images/previews/security-page.png">AppSec</a
        >
        <a
          href="#"
          class="menu-item"
          data-preview-file="itsec-overview.png"
          data-preview-accent="#7d7460"
          data-preview-img="/images/previews/itsec-overview.png">IT Sec</a
        >
      </div>
      <div class="menu-right">
        <span class="menu-battery-pct">88%</span>
        <svg
          class="menu-icon"
          width="20"
          height="14"
          viewBox="0 0 22 14"
          fill="none"
        >
          <rect
            x="1"
            y="1.5"
            width="17"
            height="11"
            rx="2.5"
            stroke="currentColor"
            stroke-width="1.3"></rect>
          <rect x="19" y="5" width="2" height="4" rx="1" fill="currentColor"
          ></rect>
          <path
            d="M11 2.3L6.6 7.8h3.1L8.2 12.2l4.9-5.5H10L11 2.3z"
            fill="currentColor"></path>
        </svg>
        <svg
          class="menu-icon"
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          ><path
            d="M1 6c4-3.5 10-3.5 14 0M3.4 8.6c3-2.3 6.2-2.3 9.2 0M5.8 11.1c1.7-1.2 2.7-1.2 4.4 0"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"></path><circle
            cx="8"
            cy="13.2"
            r="1"
            fill="currentColor"></circle></svg
        >
        <span class="menu-clock" id="menu-clock"></span>
      </div>
    </div>

    <!-- DESKTOP -->
    <div class="desktop">
      <div class="wallpaper-photo" aria-hidden="true"></div>
      <div class="wallpaper-scrim" aria-hidden="true"></div>

      <!-- WIDGET · project note (macOS Stickies style) -->
      <div class="widget widget-note pos-tl">
        <div class="widget-watermark" set:html={logoMark} />
        <div class="note-body">
          <p><em>Security</em> is not a project,</p>
          <p>It's a <em>habit</em>,</p>
          <p>We can <strong>help you</strong><br /><em>make it stick</em>.</p>
        </div>
      </div>

      <!-- WIDGET · checklist -->
      <div class="widget widget-todo pos-tr">
        <div class="widget-watermark todo-watermark" set:html={logoMark} />
        <div class="todo-bar">
          <span class="todo-dot dot-red"></span>
          <span class="todo-dot dot-yellow"></span>
          <span class="todo-dot dot-green"></span>
          <span class="todo-add">+</span>
        </div>
        <div class="todo-titlerow">
          <span class="todo-title">Reminders</span>
          <span class="todo-count">11</span>
        </div>
        <div class="todo-subrow">
          <span>0 Completed</span> · <a href="#">Clear</a><span
            class="todo-show">Show</span
          >
        </div>
        <div class="todo-list">
          <div class="widget-todo-item">
            <span class="todo-check"></span>Check if GH Action workflows avoid
            dangerous patterns
          </div>
          <div class="widget-todo-item">
            <span class="todo-check"></span>Add tests before PRs are merged
          </div>
          <div class="widget-todo-item">
            <span class="todo-check"></span>Add SAST run on all commits
          </div>
          <div class="widget-todo-item">
            <span class="todo-check"></span>Publish a security policy
          </div>
          <div class="widget-todo-item">
            <span class="todo-check"></span>Verify transport and security
            headers
          </div>
          <div class="widget-todo-item">
            <span class="todo-check"></span>Confirm that API keys, JWTs, OAuth
            tokens and session credentials cannot be reused or substituted
          </div>
          <div class="widget-todo-item">
            <span class="todo-check"></span>Verify limits per IP, user, API key
          </div>
          <div class="widget-todo-item">
            <span class="todo-check"></span>Test input validation
          </div>
          <div class="widget-todo-item">
            <span class="todo-check"></span>Check injection defenses
          </div>
          <div class="widget-todo-item">
            <span class="todo-check"></span>Review sensitive-data exposure
          </div>
          <div class="widget-todo-item">
            <span class="todo-check"></span>Check business-logic abuse
          </div>
        </div>
      </div>

      <!-- WIDGET · file -->
      <a
        class="widget widget-file pos-mr"
        href="/docs/securelayer.co.pdf"
        target="_blank"
        rel="noopener"
      >
        <div class="pdf-page">
          <div class="pdf-thumb"></div>
          <div class="pdf-badge">
            <svg width="11" height="11" viewBox="0 0 16 16" fill="none"
              ><circle cx="7" cy="7" r="5" stroke="#fff" stroke-width="1.6"
              ></circle><path
                d="M11 11l3.5 3.5"
                stroke="#fff"
                stroke-width="1.6"
                stroke-linecap="round"></path></svg
            >
          </div>
          <div class="pdf-label">PDF</div>
        </div>
        <span>What-do-we-do.pdf</span>
      </a>

      <!-- WIDGET · file (value one-pager) -->
      <a
        class="widget widget-file pos-fr"
        href="/docs/securelayer-before-you-say-you-are-secure.pdf"
        target="_blank"
        rel="noopener"
      >
        <div class="pdf-page">
          <div class="pdf-thumb"></div>
          <div class="pdf-badge">
            <svg width="11" height="11" viewBox="0 0 16 16" fill="none"
              ><circle cx="7" cy="7" r="5" stroke="#fff" stroke-width="1.6"
              ></circle><path
                d="M11 11l3.5 3.5"
                stroke="#fff"
                stroke-width="1.6"
                stroke-linecap="round"></path></svg
            >
          </div>
          <div class="pdf-label">PDF</div>
        </div>
        <span>Before-you-say-you-are-secure.pdf</span>
      </a>

      <!-- WIDGET · quick-look preview (revealed on menu-bar hover) -->
      <div class="widget widget-preview pos-tl" id="preview-window">
        <div class="preview-titlebar">
          <span class="preview-btn preview-close">&times;</span>
          <span class="preview-btn preview-expand">
            <svg width="10" height="10" viewBox="0 0 16 16" fill="none"
              ><path
                d="M6 2H2v4M10 14h4v-4M2 2l5 5M14 14l-5-5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </span>
          <span class="preview-filename" id="preview-filename"
            >security-page.png</span
          >
        </div>
        <div class="preview-body" id="preview-body">
          <img class="preview-img" id="preview-img" alt="" />
          <div class="preview-placeholder" id="preview-placeholder">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
              ><path
                d="M12 3l7 3v5c0 4.6-3 7.9-7 9-4-1.1-7-4.4-7-9V6l7-3z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"></path></svg
            >
            <span>Preview coming soon</span>
          </div>
        </div>
      </div>
    </div>

    <!-- DOCK · the real toolkit used for security work -->
    <div class="dock">
      <span class="dock-icon" title="Finder"
        ><img src="/images/dock-icons/finder.png" alt="Finder" /></span
      >
      <span class="dock-icon" title="Tutanota"
        ><img src="/images/dock-icons/tuta.png" alt="Tutanota" /></span
      >
      <span class="dock-icon" title="Proton Mail"
        ><img src="/images/dock-icons/proton.png" alt="Proton Mail" /></span
      >
      <a
        class="dock-icon dock-mobile-keep"
        href="https://signal.me/#eu/jOCElNN5Meq0MDrSKeetbOt0N7YXLFFiH37-UJO1vCdG_wY0cuVJdYbu7yFtZq62"
        target="_blank"
        rel="noopener"
        title="Signal"
        data-tooltip="Message us here — safely and privately"
        ><img src="/images/dock-icons/signal.png" alt="Signal" /></a
      >
      <a
        class="dock-icon dock-mobile-keep"
        href="https://cal.com/securelayer"
        target="_blank"
        rel="noopener"
        title="Cal.com"
        data-tooltip="Book a call with us"
        ><img src="/images/dock-icons/cal.png" alt="Cal.com" /></a
      >
      <span class="dock-icon" title="Molly"
        ><img src="/images/dock-icons/molly.png" alt="Molly" /></span
      >
      <span class="dock-icon" title="VS Code"
        ><img src="/images/dock-icons/vscode.png" alt="VS Code" /></span
      >
      <span class="dock-icon" title="Jupyter"
        ><img src="/images/dock-icons/jupyter.png" alt="Jupyter" /></span
      >
      <span class="dock-icon" title="1Password"
        ><img src="/images/dock-icons/1password.png" alt="1Password" /></span
      >
      <a
        class="dock-icon"
        href="https://securelayer.co/legal"
        title="iTerm2"
        data-tooltip="Find our legal mentions here"
        ><img src="/images/dock-icons/iterm2.svg" alt="iTerm2" /></a
      >
      <span class="dock-icon" title="NordVPN"
        ><img src="/images/dock-icons/nordvpn.svg" alt="NordVPN" /></span
      >
      <span class="dock-icon" title="OWASP ZAP"
        ><img src="/images/dock-icons/zap.svg" alt="OWASP ZAP" /></span
      >
      <span class="dock-icon" title="Multipass"
        ><img src="/images/dock-icons/multipass.png" alt="Multipass" /></span
      >
      <span class="dock-icon" title="Yubico Authenticator"
        ><img
          src="/images/dock-icons/yubico.png"
          alt="Yubico Authenticator"
        /></span
      >
      <span class="dock-icon" title="Obsidian"
        ><img src="/images/dock-icons/obsidian.png" alt="Obsidian" /></span
      >
      <span class="dock-icon" title="Bitwarden"
        ><img src="/images/dock-icons/bitwarden.png" alt="Bitwarden" /></span
      >
      <span class="dock-icon" title="OrbStack"
        ><img src="/images/dock-icons/orbstack.png" alt="OrbStack" /></span
      >
      <span class="dock-icon" title="Ollama"
        ><img src="/images/dock-icons/ollama.png" alt="Ollama" /></span
      >
      <a
        class="dock-icon dock-mobile-keep"
        href="https://securelayer.co/security"
        title="Brave"
        data-tooltip="How secure is this website?"
        ><img src="/images/dock-icons/brave.png" alt="Brave" /></a
      >
      <a
        class="dock-icon dock-mobile-keep"
        href="https://securelayer.co/sustainability/"
        title="Firefox"
        data-tooltip="What is the impact of this website on the environment?"
        ><img src="/images/dock-icons/firefox.png" alt="Firefox" /></a
      >
      <div class="dock-sep"></div>
      <div class="dock-icon dock-trash" title="Trash">
        <img src="/images/dock-icons/trash.png" alt="Trash" />
      </div>
    </div>

    <div class="dock-tooltip" id="dock-tooltip"></div>

    <!-- MOBILE SCENE · lock/unlock widget-stack (Phase B push, 2026-08-26) -->
    <div class="m-scene" id="mScene">
      <div class="m-statusbar">
        <div class="m-statusbar-brand">SecureLayer</div>
        <div class="m-statusbar-icons">
          <svg width="16" height="11" viewBox="0 0 16 11" fill="#fff"
            ><rect x="0" y="7" width="3" height="4" rx=".5"></rect><rect
              x="4.5"
              y="5"
              width="3"
              height="6"
              rx=".5"></rect><rect x="9" y="3" width="3" height="8" rx=".5"
            ></rect><rect x="13" y="0" width="3" height="11" rx=".5"
            ></rect></svg
          >
          <svg
            width="15"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#fff"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path
              d="M1.42 9a16 16 0 0 1 21.16 0"></path><path
              d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line
              x1="12"
              y1="20"
              x2="12.01"
              y2="20"></line></svg
          >
          <svg width="22" height="11" viewBox="0 0 24 12" fill="none"
            ><rect
              x="1"
              y="1.5"
              width="19"
              height="9"
              rx="2.5"
              stroke="#fff"
              stroke-width="1.2"></rect><rect
              x="21.5"
              y="4.3"
              width="2"
              height="3.4"
              rx="1"
              fill="#fff"></rect><rect
              x="2.5"
              y="3"
              width="14"
              height="6"
              rx="1.2"
              fill="#fff"></rect></svg
          >
        </div>
      </div>
      <div class="m-hp-body">
        <div class="m-stack-bg"></div>
        <div class="m-stack-scrim"></div>

        <div class="m-stack">
          <div class="m-card m-card-collage" style="--d:.05s">
            <div class="m-collage-text">
              <div class="m-notif-row">
                <img
                  class="m-notif-icon"
                  src="/images/dock-icons/cal.png"
                  alt="Cal.com"
                />
                <div class="m-notif-text">
                  <div class="m-notif-title">[APPSEC - IT - DEVOPS]</div>
                  <div class="m-notif-body">
                    Contact a security expert to check if your security is done
                    right.
                  </div>
                </div>
              </div>
              <a
                class="m-btn-amber"
                href="https://cal.com/securelayer"
                target="_blank"
                rel="noopener">Let's discuss →</a
              >
            </div>
          </div>

          <div class="m-row-note" style="--d:.1s">
            <div class="m-card m-card-note m-card-note-square">
              <div class="m-card-note-eyebrow">PRO TIPS</div>
              <p><em>Security</em> is not a project,</p>
              <p>It's a <em>habit</em>,</p>
              <p>We can <strong>help you</strong> <em>make it stick</em>.</p>
            </div>
          </div>

          <div class="m-row2" style="--d:.2s">
            <a
              class="m-card-file"
              href="/docs/securelayer.co.pdf"
              target="_blank"
              rel="noopener"
            >
              <svg class="m-folder-icon" viewBox="0 0 64 50" fill="none">
                <defs>
                  <linearGradient id="folderGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#6dd0fa"></stop>
                    <stop offset="1" stop-color="#0a84ff"></stop>
                  </linearGradient>
                </defs>
                <path
                  d="M2 10c0-2.2 1.8-4 4-4h16l5 5h31c2.2 0 4 1.8 4 4v29c0 2.2-1.8 4-4 4H6c-2.2 0-4-1.8-4-4V10z"
                  fill="url(#folderGrad)"></path>
                <rect
                  x="8"
                  y="17"
                  width="48"
                  height="3.4"
                  rx="1.7"
                  fill="#fff"
                  opacity=".85"></rect>
              </svg>
              <span>What-do-we-do.pdf</span>
              <span class="m-card-file-bar">Download the file</span>
            </a>
            <a
              class="m-card-msg"
              href="https://signal.me/#eu/jOCElNN5Meq0MDrSKeetbOt0N7YXLFFiH37-UJO1vCdG_wY0cuVJdYbu7yFtZq62"
              target="_blank"
              rel="noopener"
            >
              <img
                class="m-card-msg-icon"
                src="/images/dock-icons/signal-ultramarine.png"
                alt="Signal"
              />
              <div>
                <div class="m-card-msg-text">
                  Questions? Message us — safely and privately
                </div>
                <span class="m-btn-dark">Open Signal</span>
              </div>
            </a>
          </div>

          <div class="m-card m-card-icons-full" style="--d:.25s">
            <h3>Check our security &amp; eco-impact</h3>
            <div class="m-icon-row">
              <a
                class="m-icon-chip"
                href="/security"
                aria-label="Check our security"
                ><img src="/images/dock-icons/brave.png" alt="" /></a
              >
              <a
                class="m-icon-chip"
                href="/sustainability/"
                aria-label="Check our environmental impact"
                ><img src="/images/dock-icons/firefox.png" alt="" /></a
              >
            </div>
            <p class="m-card-social-note">
              Before we secure yours, see ours —<br />our own score is right
              there above.
            </p>
          </div>

          <div class="m-card m-card-social" style="--d:.3s">
            <h3>Check our social media</h3>
            <div class="m-icon-row m-social-icon-row">
              <a
                class="m-icon-chip"
                href="https://github.com/SecureLayer"
                target="_blank"
                rel="noopener"
                aria-label="SecureLayer on GitHub"
              >
                <svg viewBox="0 0 40 40">
                  <circle cx="20" cy="20" r="20" fill="#17140f"></circle>
                  <path
                    transform="translate(12,12) scale(1)"
                    fill="#fff"
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                  ></path>
                </svg>
              </a>
              <a
                class="m-icon-chip"
                href="https://bsky.app/profile/securelayer.co"
                target="_blank"
                rel="noopener"
                aria-label="SecureLayer on Bluesky"
              >
                <svg viewBox="0 0 40 40">
                  <circle cx="20" cy="20" r="20" fill="#0285ff"></circle>
                  <path
                    transform="translate(9,10) scale(.9)"
                    fill="#fff"
                    d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.81 9.498 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.204-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"
                  ></path>
                </svg>
              </a>
              <a
                class="m-icon-chip"
                href="https://www.instagram.com/securelayer.co/"
                target="_blank"
                rel="noopener"
                aria-label="SecureLayer on Instagram"
              >
                <svg viewBox="0 0 40 40">
                  <defs
                    ><radialGradient id="igGrad" cx=".3" cy="1.05" r="1.15"
                      ><stop offset="0" stop-color="#fdc468"></stop><stop
                        offset=".33"
                        stop-color="#e1306c"></stop><stop
                        offset=".65"
                        stop-color="#c73daa"></stop><stop
                        offset="1"
                        stop-color="#5851db"></stop></radialGradient
                    ></defs
                  >
                  <circle cx="20" cy="20" r="20" fill="url(#igGrad)"></circle>
                  <rect
                    x="11.5"
                    y="11.5"
                    width="17"
                    height="17"
                    rx="5"
                    fill="none"
                    stroke="#fff"
                    stroke-width="2.1"></rect>
                  <circle
                    cx="20"
                    cy="20"
                    r="4.6"
                    fill="none"
                    stroke="#fff"
                    stroke-width="2.1"></circle>
                  <circle cx="27.5" cy="12.3" r="1.5" fill="#fff"></circle>
                </svg>
              </a>
            </div>
            <p class="m-card-social-note">
              Our fanbase grows every day —<br />we're now dangerously close to
              double digits.
            </p>
