<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Agent Security — securelayer.co</title>
    <meta
      name="description"
      content="Can your agents be talked into anything? An assessment and incident-response service for AI agents — the exact failure mode behind the 2026 Reuters OpenAI hijack story."
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #0a0f0f;
        color: #e0e0e0;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 14px;
        line-height: 1.6;
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      .page {
        max-width: 760px;
        margin: 0 auto;
        padding: 64px 24px 24px;
      }

      /* ── Hero ── */
      .as-hero {
        text-align: center;
        margin-bottom: 64px;
      }
      .as-hero h1 {
        font-size: 2rem;
        line-height: 1.3;
        margin-bottom: 20px;
      }
      .as-hero p {
        color: #aab;
        max-width: 620px;
        margin: 0 auto;
      }
      .as-hero a {
        color: #5eead4;
        text-decoration: underline;
      }

      /* ── Content sections ── */
      .as-block {
        margin-bottom: 56px;
        padding-bottom: 56px;
        border-bottom: 1px solid #1a3030;
      }
      .as-block:last-of-type {
        border-bottom: none;
      }
      .as-eyebrow {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #5eead4;
        margin-bottom: 12px;
      }
      .as-question {
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1.35;
        margin-bottom: 14px;
      }
      .as-desc {
        color: #ccc;
        margin-bottom: 20px;
      }
      .as-highlight {
        font-size: 0.85rem;
        color: #999;
        border-left: 2px solid #5eead4;
        padding-left: 14px;
      }
      .as-highlight strong {
        color: #e0e0e0;
      }
      .as-highlight a {
        color: #5eead4;
        text-decoration: underline;
      }

      /* ── CTA ── */
      .as-cta {
        text-align: center;
        padding: 40px 24px 64px;
      }
      .as-cta h2 {
        font-size: 1.4rem;
        margin-bottom: 12px;
      }
      .as-cta p {
        color: #aab;
        max-width: 480px;
        margin: 0 auto 24px;
      }
      .as-cta-button {
        display: inline-block;
        background: #5eead4;
        color: #0a0f0f;
        font-weight: 700;
        padding: 12px 28px;
        border-radius: 100px;
      }
      .as-cta-button:hover {
        text-decoration: none;
        opacity: 0.9;
      }

      /* ── Footer (matches security.astro / ai-agent.astro) ── */
      .site-footer {
        border-top: 1px solid #1a3030;
        padding: 40px 24px;
        text-align: center;
        margin-top: 24px;
      }
      .site-footer p {
        color: #888;
        font-size: 13px;
      }
      .footer-links {
        margin-top: 14px;
        display: flex;
        justify-content: center;
        gap: 20px;
      }
      .footer-links a {
        font-size: 12px;
        color: #888;
        text-decoration: none;
      }
      .footer-links a:hover {
        color: #5eead4;
      }
      .footer-green-link {
        display: inline-block;
        margin-top: 18px;
        opacity: 0.85;
        transition: opacity 0.2s;
      }
      .footer-green-link:hover {
        opacity: 1;
      }
      .footer-green-link img {
        display: block;
        width: 100px;
        height: auto;
        margin: 0 auto;
      }
      .footer-copy {
        margin-top: 12px;
        font-size: 12px;
      }
